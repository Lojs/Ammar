# Optional — if left as-is or unset, a strong random secret is generated
# automatically on first run and saved under DATA_DIR. Set your own value
# here only if you want to control it yourself (e.g. to keep sessions valid
# across a full data-volume wipe).
JWT_SECRET=please-change-this-to-a-long-random-string
DATA_DIR=/data
# Set to 1 only if you run this behind a reverse proxy (nginx, Caddy,
# Cloudflare Tunnel, etc.) that sets X-Forwarded-For / X-Forwarded-Proto.
# Leave at 0 for direct/local access — enabling it without a real proxy in
# front lets visitors spoof their IP and bypass the login rate limit.
TRUST_PROXY=0
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=ammar/
S3_FORCE_PATH_STYLE=0
